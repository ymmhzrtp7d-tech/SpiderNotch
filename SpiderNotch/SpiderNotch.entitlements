<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets SpiderNotch send Apple Events (control Music, Spotify and browser tabs).
	     Needed when the app is signed with the hardened runtime for notarization.
	     macOS still asks you before SpiderNotch may control each app. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
